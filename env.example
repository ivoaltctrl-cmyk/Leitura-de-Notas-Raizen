# GEMINI_API_KEY: Required for Gemini AI API calls (Vision receipt extraction).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_APPS_SCRIPT_URL: Webhook URL of your Google Apps Script Web App deployed on your Google Sheet.
# Handles direct storage in Google Drive and row insertion in Google Sheets (Dados_Raizen).
GOOGLE_APPS_SCRIPT_URL=""
VITE_GOOGLE_APPS_SCRIPT_URL=""
